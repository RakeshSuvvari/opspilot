# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=#gpt-5.4-mini

# OpsPilot agent -> Go Kubernetes MCP server
OPSPILOT_K8S_MCP_URL=http://localhost:8080/mcp
OPSPILOT_DEFAULT_NAMESPACE=opspilot-demo
OPSPILOT_AGENT_MAX_TURNS=12
OPSPILOT_AGENT_MCP_TIMEOUT_SECONDS=10
OPSPILOT_AGENT_MCP_RETRIES=2
OPSPILOT_AGENT_TRACE_SENSITIVE_DATA=false
OPSPILOT_AGENT_DISABLE_TRACING=false
OPSPILOT_AGENT_HOST=127.0.0.1
OPSPILOT_AGENT_PORT=8001

# Go MCP server
OPSPILOT_MCP_ADDR=:8080

# Local PostgreSQL / pgvector
# Runtime application role used for ingestion/search.
OPSPILOT_DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/opspilot
# Administrative role used only for database/schema setup.
OPSPILOT_POSTGRES_ADMIN_URL=postgresql://ADMIN_USERNAME:PASSWORD@localhost:5432/postgres
OPSPILOT_RAG_ENABLED=true
OPSPILOT_EMBEDDING_MODEL=text-embedding-3-small
OPSPILOT_EMBEDDING_DIMENSIONS=1536
OPSPILOT_RAG_TOP_K=5
OPSPILOT_RAG_MIN_SIMILARITY=0.30
OPSPILOT_RAG_CHUNK_CHARS=1600
OPSPILOT_RAG_CHUNK_OVERLAP_CHARS=200

# Observability / trust layer
OPSPILOT_SAVE_RUN_ARTIFACTS=true
OPSPILOT_RUN_ARTIFACT_DIR=.opspilot/runs
OPSPILOT_EVAL_ARTIFACT_DIR=.opspilot/evals
OPSPILOT_TIMELINE_MAX_EVENTS=20

# GitHub deployment/source-change intelligence
OPSPILOT_GITHUB_ENABLED=true
OPSPILOT_GITHUB_MCP_URL=http://localhost:8090/mcp
# Go GitHub MCP server: fixture (deterministic demo) or live (GitHub REST API).
OPSPILOT_GITHUB_MODE=live
OPSPILOT_GITHUB_MCP_ADDR=:8090
OPSPILOT_GITHUB_FIXTURE_FILE=services/github-mcp-server/fixtures/demo.json
OPSPILOT_GITHUB_API_BASE=https://api.github.com
OPSPILOT_GITHUB_OWNER=#GitHub Username
OPSPILOT_GITHUB_REPO=opspilot
# Optional for public repository, but recommended to raise GitHub API rate limits.
# Use a fine-grained read-only token; never commit it.
GITHUB_TOKEN=


# Human-approved remediation (agent-side feature gate)
OPSPILOT_REMEDIATION_ENABLED=false
OPSPILOT_REMEDIATION_MAX_REPLICAS=10

# Incident API + dashboard
OPSPILOT_AGENT_API_URL=http://localhost:8001
OPSPILOT_INCIDENT_API_ADDR=:8088
OPSPILOT_INCIDENT_API_TIMEOUT_SECONDS=180
OPSPILOT_DASHBOARD_ORIGIN=http://localhost:5173

# Persisted incident history
OPSPILOT_HISTORY_ENABLED=true

# Phase 10 - benchmark outputs and text-token cost assumptions.
# Defaults match gpt-5.4-mini standard text-token pricing as of Sep 2026.
# Override these if OPENAI_MODEL or pricing changes.
OPSPILOT_BENCHMARK_DIR=.opspilot/benchmarks
OPSPILOT_BENCHMARK_INPUT_USD_PER_MILLION=0.75
OPSPILOT_BENCHMARK_OUTPUT_USD_PER_MILLION=4.50